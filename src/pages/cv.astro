---
import SiteLayout from "../layouts/SiteLayout.astro";
---
<SiteLayout title="CV | Jian Liu" description="Academic background, research experience, internships, international exchange, and honors of Jian Liu." activePath="/cv">
  <section class="page-hero">
    <div class="container">
      <p class="section-kicker">CURRICULUM VITAE / 04</p>
      <h1 data-en="Background & experience" data-zh="教育与经历">Background & experience</h1>
      <p class="page-lead" data-en="An overview of my academic training, research projects, engineering experience, internships, international exchange, and selected honors." data-zh="介绍我的学术背景、科研项目、工程实践、实习经历、国际交流与代表性荣誉。">An overview of my academic training, research projects, engineering experience, internships, international exchange, and selected honors.</p>
    </div>
  </section>

  <section class="section-block page-content">
    <div class="container cv-layout">
      <aside class="cv-aside">
        <div class="cv-monogram">JL</div>
        <h2>Jian Liu</h2>
        <p data-en="Interdisciplinary Researcher" data-zh="交叉学科研究者">Interdisciplinary Researcher</p>
        <div class="cv-download-placeholder">
          <span class="placeholder-icon">↓</span>
          <span data-en="A downloadable PDF CV will be added after final review." data-zh="完成最终核对后将补充可下载的 PDF 简历。">A downloadable PDF CV will be added after final review.</span>
        </div>
      </aside>

      <div class="cv-main">
        <section class="cv-section">
          <p class="section-kicker">01 / EDUCATION</p>
          <div class="timeline-entry">
            <div class="timeline-date" data-en="Undergraduate study" data-zh="本科阶段">Undergraduate study</div>
            <div>
              <h2>Harbin Institute of Technology</h2>
              <p class="timeline-subtitle" data-en="Bioinformatics" data-zh="生物信息学">Bioinformatics</p>
              <p data-en="Academic training in bioinformatics and computational biology, complemented by interdisciplinary work in artificial intelligence, scientific software, and biomedical engineering." data-zh="接受生物信息学与计算生物学方面的学术训练，并开展人工智能、科研软件和生物医学工程等交叉领域实践。">Academic training in bioinformatics and computational biology, complemented by interdisciplinary work in artificial intelligence, scientific software, and biomedical engineering.</p>
            </div>
          </div>
        </section>

        <section class="cv-section">
          <p class="section-kicker">02 / PUBLICATION</p>
          <div class="timeline-entry">
            <div class="timeline-date">2026</div>
            <div>
              <h2>First-author review in <em>International Journal of Cancer</em></h2>
              <p class="timeline-subtitle">Obesity-Driven Early-Onset Colorectal Cancer: Mechanistic Insights and Emerging Clinical Implications</p>
              <p data-en="Jian Liu, Jia Lu, Cuihong Dai, and Yingyu Zhou. Published in 2026. DOI: 10.1002/ijc.70609." data-zh="作者：Jian Liu、Jia Lu、Cuihong Dai、Yingyu Zhou。2026 年发表。DOI：10.1002/ijc.70609。">Jian Liu, Jia Lu, Cuihong Dai, and Yingyu Zhou. Published in 2026. DOI: 10.1002/ijc.70609.</p>
              <p><a class="arrow-link" href="https://doi.org/10.1002/ijc.70609" target="_blank" rel="noreferrer"><span data-en="View publication" data-zh="查看论文">View publication</span><span aria-hidden="true">↗</span></a></p>
            </div>
          </div>
        </section>

        <section class="cv-section">
          <p class="section-kicker">03 / RESEARCH EXPERIENCE</p>
          <div class="timeline-entry">
            <div class="timeline-date">2026 — present</div>
            <div>
              <h2 data-en="Scientific Software Benchmarking" data-zh="科研软件基准评测">Scientific Software Benchmarking</h2>
              <p data-en="Designing controlled comparisons of GUI and structured interfaces for scientific applications, with task suites spanning Cytoscape, PyMOL, and ImageJ." data-zh="设计科研应用中 GUI 与结构化接口的受控比较实验，任务集覆盖 Cytoscape、PyMOL 和 ImageJ。">Designing controlled comparisons of GUI and structured interfaces for scientific applications, with task suites spanning Cytoscape, PyMOL, and ImageJ.</p>
            </div>
          </div>
          <div class="timeline-entry">
            <div class="timeline-date">2026 — present</div>
            <div>
              <h2 data-en="AI for Science — State2Combo" data-zh="科学人工智能——State2Combo">AI for Science — State2Combo</h2>
              <p data-en="Developing a research prototype for human-state-guided therapeutic hypothesis generation, candidate ranking, and evidence retrieval." data-zh="开发以人类疾病状态为引导的治疗假设生成、候选排序与证据检索科研原型。">Developing a research prototype for human-state-guided therapeutic hypothesis generation, candidate ranking, and evidence retrieval.</p>
            </div>
          </div>
          <div class="timeline-entry">
            <div class="timeline-date">2026</div>
            <div>
              <h2 data-en="Morpho-Molecular Decoupling in Colorectal Cancer" data-zh="结直肠癌形态–分子解耦研究">Morpho-Molecular Decoupling in Colorectal Cancer</h2>
              <p data-en="Exploring links between stromal abundance, molecular state, and H&E whole-slide image morphology using public colorectal cancer datasets." data-zh="利用公开结直肠癌数据，探索基质丰度、分子状态与 H&E 全视野病理图像形态之间的关系。">Exploring links between stromal abundance, molecular state, and H&E whole-slide image morphology using public colorectal cancer datasets.</p>
            </div>
          </div>
          <div class="timeline-entry">
            <div class="timeline-date">2026</div>
            <div>
              <h2 data-en="Undergraduate Thesis — Silibinin and Colorectal Cancer Stroma" data-zh="本科毕业论文——水飞蓟宾与结直肠癌间质">Undergraduate Thesis — Silibinin and Colorectal Cancer Stroma</h2>
              <p data-en="Integrated 37 transcriptional programs across 11 cohorts with single-cell evidence and an AOM/DSS mouse model to study tumor-associated stromal programs." data-zh="整合 11 个队列中的 37 个转录程序、单细胞证据与 AOM/DSS 小鼠模型，研究肿瘤相关间质程序。">Integrated 37 transcriptional programs across 11 cohorts with single-cell evidence and an AOM/DSS mouse model to study tumor-associated stromal programs.</p>
            </div>
          </div>
          <div class="timeline-entry">
            <div class="timeline-date">2024 — 2025</div>
            <div>
              <h2 data-en="Yibao — Intelligent Medication-Dispensing Robot" data-zh="医宝——智能分药机器人">Yibao — Intelligent Medication-Dispensing Robot</h2>
              <p data-en="Project lead for a national-level undergraduate innovation project developing a home-assistance robot for medication dispensing, health monitoring, and environmental disinfection." data-zh="国家级大学生创新训练计划项目负责人，开发集智能分药、健康监测与环境消毒于一体的家庭辅助机器人。">Project lead for a national-level undergraduate innovation project developing a home-assistance robot for medication dispensing, health monitoring, and environmental disinfection.</p>
            </div>
          </div>
          <div class="timeline-entry">
            <div class="timeline-date">2024 — 2026</div>
            <div>
              <h2 data-en="Biomedical Signal and Nanorobotics Projects" data-zh="生物医学信号与纳米机器人项目">Biomedical Signal and Nanorobotics Projects</h2>
              <p data-en="Participated in project work spanning cross-subject EEG emotion recognition, multimodal EEG–fNIRS modeling, and magnetic swimming nanorobots for thrombus-targeted therapy." data-zh="参与跨被试 EEG 情绪识别、EEG–fNIRS 多模态建模及面向血栓靶向治疗的磁性游动纳米机器人等项目。">Participated in project work spanning cross-subject EEG emotion recognition, multimodal EEG–fNIRS modeling, and magnetic swimming nanorobots for thrombus-targeted therapy.</p>
            </div>
          </div>
          <div class="timeline-entry">
            <div class="timeline-date">Research training</div>
            <div>
              <h2 data-en="Pancreatic Cancer Metabolism and Drug Resistance" data-zh="胰腺癌代谢与药物耐药研究">Pancreatic Cancer Metabolism and Drug Resistance</h2>
              <p data-en="Laboratory research experience documented in cell-model, qPCR, MTT, flow-cytometry, and metabolomics records." data-zh="相关实验记录涉及细胞模型、qPCR、MTT、流式细胞术及代谢组学分析。">Laboratory research experience documented in cell-model, qPCR, MTT, flow-cytometry, and metabolomics records.</p>
            </div>
          </div>
        </section>

        <section class="cv-section">
          <p class="section-kicker">04 / INTERNSHIPS</p>
          <div class="timeline-entry">
            <div class="timeline-date">2025.12 — 2026.01</div>
            <div>
              <h2 data-en="AI Agent Engineering Intern" data-zh="AI Agent 工程实习">AI Agent Engineering Intern</h2>
              <p data-en="Worked on backend task flows, automation components, interface integration, and system reliability improvements." data-zh="参与后端任务流、自动化组件、接口联调与系统稳定性优化。">Worked on backend task flows, automation components, interface integration, and system reliability improvements.</p>
            </div>
          </div>
          <div class="timeline-entry">
            <div class="timeline-date">2025.11 — 2026.02</div>
            <div>
              <h2 data-en="Intelligent Financial Modeling Agent Intern" data-zh="智能财务建模 Agent 实习">Intelligent Financial Modeling Agent Intern</h2>
              <p data-en="Contributed to agent-assisted financial modeling workflows and intelligent task automation." data-zh="参与智能财务建模工作流与智能任务自动化相关工作。">Contributed to agent-assisted financial modeling workflows and intelligent task automation.</p>
            </div>
          </div>
        </section>

        <section class="cv-section">
          <p class="section-kicker">05 / INTERNATIONAL EXPERIENCE</p>
          <div class="timeline-entry">
            <div class="timeline-date">22–26 Sep 2025</div>
            <div>
              <h2 data-en="HIT Academic Exchange in Singapore" data-zh="哈工大新加坡学术交流">HIT Academic Exchange in Singapore</h2>
              <p data-en="Visited the National University of Singapore and Nanyang Technological University with an HIT delegation; attended academic seminars and visited laboratories working in nanomedicine, biomaterials, drug delivery, and 2D materials." data-zh="随哈工大代表团访问新加坡国立大学与南洋理工大学，参加学术讲座并参观纳米医学、生物材料、药物递送和二维材料相关实验室。">Visited the National University of Singapore and Nanyang Technological University with an HIT delegation; attended academic seminars and visited laboratories working in nanomedicine, biomaterials, drug delivery, and 2D materials.</p>
              <p><a class="arrow-link" href="https://today.hit.edu.cn/article/2025/10/17/125210" target="_blank" rel="noreferrer"><span data-en="HIT official exchange report" data-zh="哈工大官方交流报道">HIT official exchange report</span><span aria-hidden="true">↗</span></a></p>
            </div>
          </div>
        </section>

        <section class="cv-section">
          <p class="section-kicker">06 / SELECTED HONORS & AWARDS</p>
          <div class="honor-list">
            <div class="honor-entry"><span>2026</span><p data-en="University Scholarship, Harbin Institute of Technology" data-zh="哈尔滨工业大学校级奖学金">University Scholarship, Harbin Institute of Technology</p></div>
            <div class="honor-entry"><span>2026</span><p data-en="Outstanding Student Cadre, Harbin Institute of Technology" data-zh="哈尔滨工业大学优秀学生干部">Outstanding Student Cadre, Harbin Institute of Technology</p></div>
            <div class="honor-entry"><span>2023–24</span><p data-en="Outstanding Student Award, Harbin Institute of Technology" data-zh="哈尔滨工业大学优秀学生">Outstanding Student Award, Harbin Institute of Technology</p></div>
            <div class="honor-entry"><span>2025</span><p data-en="MCM/ICM — Honorable Mention (H Award), Team 2514199" data-zh="美国大学生数学建模竞赛（MCM/ICM）H 奖，团队编号 2514199">MCM/ICM — Honorable Mention (H Award), Team 2514199</p></div>
            <div class="honor-entry"><span>—</span><p data-en="National Undergraduate Mathematical Modeling Contest — Heilongjiang Provincial First Prize" data-zh="全国大学生数学建模竞赛——黑龙江省级一等奖">National Undergraduate Mathematical Modeling Contest — Heilongjiang Provincial First Prize</p></div>
            <div class="honor-entry"><span>—</span><p data-en="Zhengda Cup Market Research and Analysis Competition — Provincial First Prize and National Second Prize" data-zh="正大杯市场调查与分析大赛——省级一等奖、国家级二等奖">Zhengda Cup Market Research and Analysis Competition — Provincial First Prize and National Second Prize</p></div>
            <div class="honor-entry"><span>—</span><p data-en="11th National Biomedical Engineering Innovation Design Competition — National Second Prize (EEG project)" data-zh="第十一届全国大学生生物医学工程创新设计大赛——国家级二等奖（EEG 项目）">11th National Biomedical Engineering Innovation Design Competition — National Second Prize (EEG project)</p></div>
            <div class="honor-entry"><span>2024</span><p data-en="9th National Biomedical Engineering Innovation Design Competition — Third Prize (magnetic nanorobot project)" data-zh="第九届全国大学生生物医学工程创新设计竞赛——三等奖（磁性纳米机器人项目）">9th National Biomedical Engineering Innovation Design Competition — Third Prize (magnetic nanorobot project)</p></div>
            <div class="honor-entry"><span>2025</span><p data-en="8th China University Intelligent Robot Creative Competition — National Third Prize (Yibao project)" data-zh="第八届中国高校智能机器人创意大赛——国家级三等奖（医宝项目）">8th China University Intelligent Robot Creative Competition — National Third Prize (Yibao project)</p></div>
            <div class="honor-entry"><span>2025</span><p data-en="Bi Sheng Cup Heilongjiang University Intelligent Robot Creative Competition — Provincial Second Prize (Yibao project)" data-zh="黑龙江省“毕昇杯”高校智能机器人创意大赛——省级二等奖（医宝项目）">Bi Sheng Cup Heilongjiang University Intelligent Robot Creative Competition — Provincial Second Prize (Yibao project)</p></div>
          </div>
        </section>
      </div>
    </div>
  </section>
</SiteLayout>
