---
import SiteLayout from "../layouts/SiteLayout.astro";
---
<SiteLayout title="CV | Jian Liu" description="Academic background, selected experience, and awards of Jian Liu." activePath="/cv">
  <section class="page-hero">
    <div class="container">
      <p class="section-kicker">CURRICULUM VITAE / 04</p>
      <h1 data-en="Background & experience" data-zh="教育与经历">Background & experience</h1>
      <p class="page-lead" data-en="A concise overview of my academic background, research experience, and selected honors." data-zh="简要介绍我的学术背景、科研经历与代表性荣誉。">A concise overview of my academic background, research experience, and selected honors.</p>
    </div>
  </section>

  <section class="section-block page-content">
    <div class="container cv-layout">
      <aside class="cv-aside">
        <div class="cv-monogram">JL</div>
        <h2>Jian Liu</h2>
        <p data-en="Bioinformatics Researcher" data-zh="生物信息学研究者">Bioinformatics Researcher</p>
        <div class="cv-download-placeholder">
          <span class="placeholder-icon">↓</span>
          <span data-en="PDF CV will be added before public launch." data-zh="正式发布前将补充 PDF 简历。">PDF CV will be added before public launch.</span>
        </div>
      </aside>

      <div class="cv-main">
        <section class="cv-section">
          <p class="section-kicker">01 / EDUCATION</p>
          <div class="timeline-entry">
            <div class="timeline-date" data-en="Undergraduate" data-zh="本科阶段">Undergraduate</div>
            <div>
              <h2>Harbin Institute of Technology</h2>
              <p class="timeline-subtitle" data-en="Bioinformatics" data-zh="生物信息学">Bioinformatics</p>
              <p data-en="Academic training in computational biology, bioinformatics, and interdisciplinary research." data-zh="接受计算生物学、生物信息学及交叉研究方面的学术训练。">Academic training in computational biology, bioinformatics, and interdisciplinary research.</p>
            </div>
          </div>
        </section>

        <section class="cv-section">
          <p class="section-kicker">02 / RESEARCH & TECHNICAL EXPERIENCE</p>
          <div class="timeline-entry">
            <div class="timeline-date">2025 — 2026</div>
            <div>
              <h2 data-en="AI Agent Engineering" data-zh="AI Agent 工程实践">AI Agent Engineering</h2>
              <p data-en="Worked on backend task flows, automation components, interface integration, and reliability improvements." data-zh="参与后端任务流、自动化组件、接口联调与系统稳定性优化。">Worked on backend task flows, automation components, interface integration, and reliability improvements.</p>
            </div>
          </div>
          <div class="timeline-entry">
            <div class="timeline-date">2025 — 2026</div>
            <div>
              <h2 data-en="Intelligent Financial Modeling Agent" data-zh="智能财务建模 Agent">Intelligent Financial Modeling Agent</h2>
              <p data-en="Contributed to the development and workflow design of an agent-assisted financial modeling system." data-zh="参与智能财务建模系统的开发与智能体工作流设计。">Contributed to the development and workflow design of an agent-assisted financial modeling system.</p>
            </div>
          </div>
        </section>

        <section class="cv-section">
          <p class="section-kicker">03 / SELECTED HONORS</p>
          <div class="honor-list">
            <div class="honor-entry"><span>2026</span><p data-en="University Scholarship" data-zh="校级奖学金">University Scholarship</p></div>
            <div class="honor-entry"><span>2026</span><p data-en="Outstanding Student Cadre, Harbin Institute of Technology" data-zh="哈尔滨工业大学优秀学生干部">Outstanding Student Cadre, Harbin Institute of Technology</p></div>
            <div class="honor-entry"><span>2025</span><p data-en="Mathematical Contest in Modeling / Interdisciplinary Contest in Modeling (MCM/ICM) — Honorable Mention" data-zh="美国大学生数学建模竞赛（MCM/ICM）— H 奖">Mathematical Contest in Modeling / Interdisciplinary Contest in Modeling (MCM/ICM) — Honorable Mention</p></div>
            <div class="honor-entry"><span>2025</span><p data-en="Zhengda Cup Market Research and Analysis Competition — National Second Prize" data-zh="正大杯市场调查与分析大赛 — 国家级二等奖">Zhengda Cup Market Research and Analysis Competition — National Second Prize</p></div>
          </div>
        </section>
      </div>
    </div>
  </section>
</SiteLayout>
