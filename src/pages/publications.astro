---
import SiteLayout from "../layouts/SiteLayout.astro";
---
<SiteLayout title="Publications | Jian Liu" description="Peer-reviewed publications by Jian Liu." activePath="/publications">
  <section class="page-hero">
    <div class="container">
      <p class="section-kicker">PUBLICATIONS / 02</p>
      <h1 data-en="Publications" data-zh="论文发表">Publications</h1>
      <p class="page-lead" data-en="Peer-reviewed research and scholarly work. Published articles are listed separately from ongoing projects and manuscripts in preparation." data-zh="同行评审论文与学术成果。正式发表论文与进行中的研究、准备中的稿件分别呈现。">Peer-reviewed research and scholarly work. Published articles are listed separately from ongoing projects and manuscripts in preparation.</p>
    </div>
  </section>

  <section class="section-block page-content">
    <div class="container">
      <div class="publication-list">
        <article class="publication-row">
          <div class="publication-year">2026</div>
          <div class="publication-main">
            <div class="publication-topline">
              <span class="status-pill" data-en="PUBLISHED" data-zh="已发表">PUBLISHED</span>
              <span class="publication-type" data-en="Narrative Review · First Author" data-zh="叙述性综述 · 第一作者">Narrative Review · First Author</span>
            </div>
            <h2>Obesity-Driven Early-Onset Colorectal Cancer: Mechanistic Insights and Emerging Clinical Implications</h2>
            <p class="journal-name"><em>International Journal of Cancer</em>, 2026; 0:1–12.</p>
            <p class="publication-authors"><strong>Jian Liu</strong>, Jia Lu, Cuihong Dai, Yingyu Zhou.</p>
            <p class="publication-note" data-en="Author contributions: conceptualization, investigation, formal analysis, visualization, writing – original draft, and data curation." data-zh="作者贡献：研究构思、研究实施、正式分析、可视化、初稿撰写及数据整理。">Author contributions: conceptualization, investigation, formal analysis, visualization, writing – original draft, and data curation.</p>
            <p class="publication-doi">DOI: <a href="https://doi.org/10.1002/ijc.70609" target="_blank" rel="noreferrer">10.1002/ijc.70609 ↗</a></p>
          </div>
        </article>
      </div>
      <div class="empty-note">
        <span class="empty-note-mark">+</span>
        <p data-en="Additional manuscripts, preprints, and conference outputs will be listed here only when their status and public-disclosure permissions are clear." data-zh="其他稿件、预印本及会议成果将在其状态和公开权限明确后补充至此。">Additional manuscripts, preprints, and conference outputs will be listed here only when their status and public-disclosure permissions are clear.</p>
      </div>
    </div>
  </section>
</SiteLayout>
