---
import SiteLayout from "../layouts/SiteLayout.astro";
---
<SiteLayout title="Publications | Jian Liu" description="Selected publications by Jian Liu." activePath="/publications">
  <section class="page-hero">
    <div class="container">
      <p class="section-kicker">PUBLICATIONS / 02</p>
      <h1 data-en="Publications" data-zh="论文发表">Publications</h1>
      <p class="page-lead" data-en="Selected peer-reviewed research and scholarly work. Bibliographic records are being carefully verified before public release." data-zh="代表性同行评审研究与学术成果。所有书目信息将在公开发布前仔细核对。">Selected peer-reviewed research and scholarly work. Bibliographic records are being carefully verified before public release.</p>
    </div>
  </section>

  <section class="section-block page-content">
    <div class="container">
      <div class="publication-list">
        <article class="publication-row">
          <div class="publication-year">2026</div>
          <div class="publication-main">
            <div class="publication-topline">
              <span class="status-pill" data-en="ACCEPTED" data-zh="已接收">ACCEPTED</span>
              <span class="publication-type" data-en="Narrative Review" data-zh="叙述性综述">Narrative Review</span>
            </div>
            <h2>Obesity-Driven Early-Onset Colorectal Cancer: Mechanistic Insights and Emerging Clinical Implications</h2>
            <p class="journal-name"><em>International Journal of Cancer</em></p>
            <p class="publication-note" data-en="Accepted: May 2026. DOI, volume, pages, and final author metadata will be added after verification against the publisher record." data-zh="接收时间：2026 年 5 月。DOI、卷期页码及最终作者信息将在与出版社记录核对后补充。">Accepted: May 2026. DOI, volume, pages, and final author metadata will be added after verification against the publisher record.</p>
          </div>
        </article>
      </div>
      <div class="empty-note">
        <span class="empty-note-mark">+</span>
        <p data-en="Additional manuscripts and preprints will be listed here when they are ready for public disclosure." data-zh="其他论文及预印本将在适合公开时补充至此。">Additional manuscripts and preprints will be listed here when they are ready for public disclosure.</p>
      </div>
    </div>
  </section>
</SiteLayout>
