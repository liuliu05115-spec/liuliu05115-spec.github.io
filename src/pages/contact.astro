---
import SiteLayout from "../layouts/SiteLayout.astro";
---
<SiteLayout title="Contact | Jian Liu" description="Contact information for Jian Liu." activePath="/contact">
  <section class="page-hero">
    <div class="container">
      <p class="section-kicker">CONTACT / 05</p>
      <h1 data-en="Let's connect." data-zh="欢迎交流。">Let's connect.</h1>
      <p class="page-lead" data-en="I welcome conversations about research collaboration, scientific AI, computational biology, and academic opportunities." data-zh="欢迎就科研合作、科学人工智能、计算生物学及学术机会进行交流。">I welcome conversations about research collaboration, scientific AI, computational biology, and academic opportunities.</p>
    </div>
  </section>

  <section class="section-block page-content contact-content">
    <div class="container contact-panel">
      <div>
        <p class="section-kicker">OPEN TO</p>
        <h2 data-en="Research conversations and collaboration" data-zh="科研交流与合作">Research conversations and collaboration</h2>
        <p data-en="My public academic email address and verified profile links will be added here before the website is launched." data-zh="正式上线前，我会在这里补充公开学术邮箱及经过核实的个人主页链接。">My public academic email address and verified profile links will be added here before the website is launched.</p>
      </div>
      <div class="contact-mark">JL<span>↗</span></div>
    </div>
  </section>
</SiteLayout>
