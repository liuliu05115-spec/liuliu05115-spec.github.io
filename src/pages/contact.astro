---
import SiteLayout from "../layouts/SiteLayout.astro";
---
<SiteLayout title="Contact | Jian Liu" description="Contact and public profile links for Jian Liu." activePath="/contact">
  <section class="page-hero">
    <div class="container">
      <p class="section-kicker">CONTACT / 05</p>
      <h1 data-en="Let's connect." data-zh="欢迎交流。">Let's connect.</h1>
      <p class="page-lead" data-en="I welcome conversations about research collaboration, scientific AI, scientific software, computational biology, and interdisciplinary academic opportunities." data-zh="欢迎就科研合作、科学人工智能、科研软件、计算生物学及交叉学科学术机会进行交流。">I welcome conversations about research collaboration, scientific AI, scientific software, computational biology, and interdisciplinary academic opportunities.</p>
    </div>
  </section>

  <section class="section-block page-content contact-content">
    <div class="container contact-panel">
      <div>
        <p class="section-kicker">PUBLIC PROFILE</p>
        <h2 data-en="Research conversations and collaboration" data-zh="科研交流与合作">Research conversations and collaboration</h2>
        <p data-en="For now, you can explore my public projects through GitHub. A dedicated academic email address and additional scholarly profiles can be added after they are confirmed for public use." data-zh="目前可通过公开 GitHub 主页查看我的项目。待确认可公开使用的学术邮箱及其他学术主页后，我会继续补充。">For now, you can explore my public projects through GitHub. A dedicated academic email address and additional scholarly profiles can be added after they are confirmed for public use.</p>
        <div class="contact-links">
          <a href="https://github.com/liuliu05115-spec" target="_blank" rel="noreferrer">GitHub · liuliu05115-spec <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <div class="contact-mark">JL<span>↗</span></div>
    </div>
  </section>
</SiteLayout>
