        zhStatus: "已完成 · 获奖项目",
      },
    ],
  },
];
---
<SiteLayout title="Projects | Jian Liu" description="Selected research, engineering, and data-science projects by Jian Liu." activePath="/projects">
  <section class="page-hero">
    <div class="container">
      <p class="section-kicker">PROJECTS / 03</p>
      <h1 data-en="Projects & portfolio" data-zh="项目与作品集">Projects & portfolio</h1>
      <p class="page-lead" data-en="A structured portfolio of research, competitions, and engineering projects. Each entry highlights its project source, award or outcome, a concise introduction, my role, and supporting materials where public release is approved." data-zh="以作品集形式整理科研、竞赛与工程项目。每项经历均展示项目来源、获奖或成果、项目简介、个人职责，以及经审核可公开的支撑材料。">A structured portfolio of research, competitions, and engineering projects. Each entry highlights its project source, award or outcome, a concise introduction, my role, and supporting materials where public release is approved.</p>
      <div class="portfolio-summary">
        <span><strong>13</strong><small data-en="Selected projects" data-zh="项代表项目">Selected projects</small></span>
        <span><strong>04</strong><small data-en="Research & project areas" data-zh="大项目类别">Research & project areas</small></span>
        <span><strong>PDF</strong><small data-en="Reports & project materials" data-zh="报告与项目材料">Reports & project materials</small></span>
      </div>
    </div>
  </section>

  <section class="section-block page-content">
    <div class="container project-groups">
      {groups.map((group) => (
        <section class="project-group" id={group.id}>
          <div class="project-group-heading">
            <p class="section-kicker">SELECTED WORK</p>
            <h2 data-en={group.title} data-zh={group.zhTitle}>{group.title}</h2>
          </div>
          <div class="portfolio-grid">
            {group.projects.map((project) => (
              <article class="portfolio-card" id={project.id}>
                <div class="portfolio-card-top">
                  <span class="portfolio-number">{project.number}</span>
                  <span class="project-status" data-en={project.status} data-zh={project.zhStatus}>{project.status}</span>
                </div>
                <p class="portfolio-category">{project.category}</p>
                <h3 data-en={project.title} data-zh={project.zhTitle}>{project.title}</h3>
                <p class="project-subtitle" data-en={project.subtitle} data-zh={project.zhSubtitle}>{project.subtitle}</p>

                <div class="portfolio-facts">
                  <div class="portfolio-fact">
                    <span class="portfolio-label" data-en="COMPETITION / PROJECT" data-zh="比赛 / 项目来源">COMPETITION / PROJECT</span>
                    <p data-en={project.source} data-zh={project.zhSource}>{project.source}</p>
                  </div>
                  <div class="portfolio-fact">
                    <span class="portfolio-label" data-en="AWARD / OUTCOME" data-zh="获得奖项 / 项目成果">AWARD / OUTCOME</span>
                    <p class="portfolio-award" data-en={project.award} data-zh={project.zhAward}>{project.award}</p>
                  </div>
                </div>

                <div class="portfolio-description">
                  <span class="portfolio-label" data-en="PROJECT OVERVIEW" data-zh="项目简介">PROJECT OVERVIEW</span>
                  <p data-en={project.description} data-zh={project.zhDescription}>{project.description}</p>
                  <p class="portfolio-context" data-en={project.context} data-zh={project.zhContext}>{project.context}</p>
                </div>

                <div class="portfolio-contribution">
                  <span class="portfolio-label" data-en="MY CONTRIBUTION" data-zh="个人职责">MY CONTRIBUTION</span>
                  <p data-en={project.role} data-zh={project.zhRole}>{project.role}</p>
                </div>

                <div class="portfolio-materials">
                  <span class="portfolio-label" data-en="PROJECT MATERIALS" data-zh="项目材料">PROJECT MATERIALS</span>
                  {project.materials.length > 0 ? (
                    <div class="portfolio-material-list">
                      {project.materials.map((material) => (
                        <a class="portfolio-material-link" href={material.href} target="_blank" rel="noreferrer">
                          <span class="material-file-icon">PDF</span>
                          <span class="material-file-name">{material.label}</span>
                          <span class="material-open" aria-hidden="true">↗</span>
                        </a>
                      ))}
                    </div>
                  ) : (
                    <p class="portfolio-material-pending" data-en="PDF materials are being reviewed for personal information, team details, and public-release permissions before upload." data-zh="PDF 原件正在进行个人信息、团队信息及公开权限检查，审核通过后再上传。">PDF materials are being reviewed for personal information, team details, and public-release permissions before upload.</p>
                  )}
                </div>

                <div class="tag-row">{project.tags.map((tag) => <span>{tag}</span>)}</div>
              </article>
            ))}
          </div>
        </section>
      ))}
    </div>
  </section>
</SiteLayout>
